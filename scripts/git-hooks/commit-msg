#!/usr/bin/env bash
#
# Strips attribution trailers from the commit message.
#
# Lagoon's history carries the ticket key and nothing else — no Co-Authored-By,
# no tool attribution. Agents and editors add those on their own, so relying on
# remembering not to has already put 153 of them in the published history. This
# removes them at the point the message is written instead.
#
# Runs as git's commit-msg hook, so it covers `-m`, `--amend`, squashes and
# editor commits alike. `git commit --no-verify` skips it, as with any hook.
#
# Installed by pointing the repository at this directory:
#
#   git config core.hooksPath scripts/git-hooks
#
set -euo pipefail

message="${1:-}"
[ -n "$message" ] && [ -f "$message" ] || exit 0

# Trailers to drop, matched case-insensitively at the start of a line. Git's own
# trailer syntax allows leading whitespace, so tolerate it.
patterns=(
    'co-authored-by:'
    'claude-session:'
)

before="$(cat "$message")"

# A hook must never be the reason a commit fails. If the interpreter is missing
# the message goes through unchanged, with a warning, rather than blocking work.
if ! command -v python3 >/dev/null 2>&1; then
    echo "commit-msg: python3 not found, leaving the message alone" >&2
    exit 0
fi

python3 - "$message" "${patterns[@]}" <<'PY'
import re
import sys

path, patterns = sys.argv[1], sys.argv[2:]
text = open(path, encoding="utf-8").read()

# Drop whole trailer lines. Comment lines are left alone: git strips them later,
# and the instructions git writes into the template mention these names.
trailer = re.compile(
    r"^[ \t]*(?:%s)[^\n]*\n?" % "|".join(re.escape(p) for p in patterns),
    re.IGNORECASE | re.MULTILINE,
)
kept = []
for line in text.splitlines(keepends=True):
    if line.lstrip().startswith("#") or not trailer.match(line):
        kept.append(line)
text = "".join(kept)

# Removing a trailer block leaves the blank line that separated it from the
# body. Collapse runs of blank lines and re-terminate the file.
text = re.sub(r"\n{3,}", "\n\n", text)
text = text.rstrip("\n")
if text:
    text += "\n"

open(path, "w", encoding="utf-8").write(text)
PY

if [ "$before" != "$(cat "$message")" ]; then
    echo "commit-msg: stripped attribution trailer(s)" >&2
fi
