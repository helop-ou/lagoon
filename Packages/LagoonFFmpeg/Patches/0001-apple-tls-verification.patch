+#ifdef __APPLE__
+/* GnuTLS does not load system roots on iOS/tvOS. Evaluate the actual TLS
+ * peer chain using Apple's server policy, including the destination hostname.
+ * Peer certificates are intermediates, never additional trust anchors. */
+static int tls_verify_apple(URLContext *h, gnutls_session_t session,
+                            const char *hostname)
+{
+    unsigned int count = 0;
+    const gnutls_datum_t *peers;
+    CFMutableArrayRef certificates = NULL;
+    CFStringRef host = NULL;
+    SecPolicyRef policy = NULL;
+    SecTrustRef trust = NULL;
+    int ret = AVERROR(EIO);
+
+    if (!hostname || !hostname[0] ||
+        gnutls_certificate_type_get(session) != GNUTLS_CRT_X509)
+        goto end;
+    peers = gnutls_certificate_get_peers(session, &count);
+    if (!peers || !count)
+        goto end;
+    certificates = CFArrayCreateMutable(NULL, 0, &kCFTypeArrayCallBacks);
+    if (!certificates)
+        goto end;
+    for (unsigned int i = 0; i < count; i++) {
+        CFDataRef der = CFDataCreate(NULL, peers[i].data, peers[i].size);
+        SecCertificateRef certificate = der ? SecCertificateCreateWithData(NULL, der) : NULL;
+        if (der)
+            CFRelease(der);
+        if (!certificate)
+            goto end;
+        CFArrayAppendValue(certificates, certificate);
+        CFRelease(certificate);
+    }
+    host = CFStringCreateWithCString(NULL, hostname, kCFStringEncodingUTF8);
+    if (!host)
+        goto end;
+    policy = SecPolicyCreateSSL(true, host);
+    if (!policy || SecTrustCreateWithCertificates(certificates, policy, &trust) != errSecSuccess)
+        goto end;
+    /* Offline evaluation keeps FFmpeg's network timeout/cancellation bounded.
+     * Servers must send their intermediates; installed/system roots are used. */
+    if (SecTrustSetNetworkFetchAllowed(trust, false) != errSecSuccess)
+        goto end;
+    if (SecTrustEvaluateWithError(trust, NULL))
+        ret = 0;
+end:
+    if (trust) CFRelease(trust);
+    if (policy) CFRelease(policy);
+    if (host) CFRelease(host);
+    if (certificates) CFRelease(certificates);
+    if (ret < 0)
+        av_log(h, AV_LOG_ERROR, "TLS peer certificate or hostname failed Apple trust verification\n");
+    return ret;
+}
+#endif
