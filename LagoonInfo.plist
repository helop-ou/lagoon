<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AVInitialRouteSharingPolicy</key>
	<string>LongFormVideo</string>
	<!-- OpenSubtitles consumer key (HEL-92). Register one free at
	     opensubtitles.com under API Consumers and paste it here to have every
	     build carry it; leaving it empty is supported, and Settings ->
	     Subtitles -> OpenSubtitles accepts a key per device instead. It is a
	     rate-limiting identifier rather than a user secret. -->
	<key>LagoonOpenSubtitlesAPIKey</key>
	<string></string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>ee.helop.lagoon</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lagoon</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Lagoon connects to the Jellyfin and Seerr servers you choose on your local network to browse your library, play media, and manage requests.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
