#!/usr/bin/env bash
#
# Checks each pushed branch's name and commits before they reach GitHub, the
# part of scripts/check-pull-request.sh that needs no pull request. Turn it on
# once per clone: git config core.hooksPath .githooks
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
status=0
while read -r local_ref local_sha _ _; do
    [[ "$local_ref" == refs/heads/* ]] || continue
    # A deleted branch pushes all zeros.
    [[ "$local_sha" =~ ^0+$ ]] && continue
    branch="${local_ref#refs/heads/}"
    [[ "$branch" == main ]] && continue
    echo "Checking $branch"
    BRANCH="$branch" BASE=origin/main HEAD="$local_sha" "$root/scripts/check-pull-request.sh" || status=1
done
exit $status
